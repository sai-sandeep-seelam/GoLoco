{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_SQL_CONNECTION_STRING"
  },
  "Storage": {
    "Provider": "Azure"
  },
  "Email": {
    "SenderAddress": "",
    "SenderName": "",
    "Region": "ap-south-1"
  },
  "AwsS3": {
    "BucketName": "YOUR_S3_BUCKET_NAME",
    "Region": "YOUR_AWS_REGION"
  },
  "AzureBlobStorage": {
    "ConnectionString": "YOUR_BLOB_CONNECTION_STRING",
    "ContainerName": "event-images"
  },
  "JwtSettings": {
    "Key": "super_secret_development_key_1234567890",
    "Issuer": "OnlineEventTicketManagementAPI",
    "Audience": "OnlineEventTicketManagementClient",
    "DurationInMinutes": 120
  }
}
